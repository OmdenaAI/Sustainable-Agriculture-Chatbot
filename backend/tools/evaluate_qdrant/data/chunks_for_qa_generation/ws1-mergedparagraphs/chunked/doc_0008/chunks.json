    "chunk_id": "06cf2680-f047-456e-94ee-d10c955a88cb",
    "chunk_index": 16,
    "section_title": "CB8350EN/1/03.22 \u2013 Revised version",
    "text": "CB8350EN/1/03.22 \u2013 Revised version\n\nThis reduces soil erosion and preserves soil organic matter.",
    "paragraph_id": "18ef69e3-985c-472f-9013-ac3dc696f549",
    "paragraph_index": 0
  },
